# Copiar a .env y cambiar los valores. El archivo .env NO se sube al repositorio.

# Secretos compartidos
JWT_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
SERVICE_TOKEN=cambiar-token-interno-entre-servicios

# Una contraseña distinta por base de datos (RNF03)
PASS_USUARIOS=cambiar-usuarios
PASS_CATALOGO=cambiar-catalogo
PASS_PRESTAMOS=cambiar-prestamos
PASS_NOTIFICACIONES=cambiar-notificaciones

DOMINIO_CORREO=itleon.edu.mx

# IP de tu equipo en la red (para el certificado HTTPS y para la app móvil). Opcional.
HOST_PUBLICO=

# Parámetros de negocio (sección 2.3) · valores de ejemplo por confirmar con la institución
LIMITE_PRESTAMOS=3
DIAS_PRESTAMO_LIBRO=7
DIAS_PRESTAMO_EQUIPO=3
MAX_RENOVACIONES=1
HORAS_RESERVA=72
TARIFA_DIARIA=10.00
DIAS_TOLERANCIA=0
TOPE_MULTA=0
DIAS_AVISO=1

# Contraseña de las cuentas de prueba que crea scripts/cargar-datos-demo.sh.
# En un servidor público, cámbiala (deploy/instalar.sh genera una al azar).
SEED_PASSWORD=Biblio2026!
